rules_version = '2';

// ===============================================================
// ServicePilot — Firebase Storage rules
// ===============================================================
//
// bookings/{customerId}/{bookingId}/{file}
//   Problem photos attached to a repair request (US-12 / SCRUM-43).
//   PLAN.md: up to 5 photos per booking, each at most 5 MB, images only.
//
//   - Write: only the customer whose UID is in the path. The booking
//     document does not exist yet while photos upload, so the path is
//     the only thing to check against.
//   - Read: that customer or an admin, or the provider and assigned
//     technician after acceptance. Checked against the
//     Firestore booking (cross-service rules; the first deploy asks to
//     grant Storage access to Firestore).
//   - Files are never changed or deleted from the app.
//
// Everything else is closed.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function booking(bookingId) {
      return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
    }

    function isBookingParticipant(job) {
      let uid = request.auth.uid;
      let account = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return account != null && account.get('status', '') != 'suspended' &&
        ((job.providerId == uid && (account.role == 'independent_provider' ||
          (account.role == 'company' && account.get('companyId', uid) == uid))) ||
         (job.get('technicianId', '') == uid &&
          account.role in ['company_technician', 'companyTechnician'] &&
          account.get('status', '') == 'active' &&
          account.get('companyId', '') == job.providerId));
    }

    function canSeeJobPhoto(customerId, bookingId) {
      let job = booking(bookingId);
      return job != null && job.customerId == customerId &&
        job.status in ['confirmed', 'assigned', 'in_progress', 'completed'] &&
        isBookingParticipant(job);
    }

    // Admin custom claims only (set with the Admin SDK). Unlike
    // firestore.rules, an email address containing "admin" is not enough.
    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.get('admin', false) == true ||
          request.auth.token.get('role', '') == 'admin');
    }

    match /bookings/{customerId}/{bookingId}/{fileName} {
      allow create: if isSignedIn() &&
                       request.auth.uid == customerId &&
                       request.resource.size <= 5 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');

      allow read: if isSignedIn() &&
                     (
                       request.auth.uid == customerId ||
                       isAdmin() ||
                       canSeeJobPhoto(customerId, bookingId)
                     );

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
